# 复制为同目录的 .env.local.properties 后填写，勿提交真实凭证；修改后重启后端。

# 飞书登录
# 飞书应用 ID。
FEISHU_APP_ID=cli_aa64531940e15c1e
# 飞书应用密钥。
FEISHU_APP_SECRET=
# 本公司飞书企业标识，用于校验登录归属。
FEISHU_TENANT_KEY=
# 允许的前端地址，多个用英文逗号分隔，不带路径和末尾 /。
FEISHU_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 吉客云商品查询与导入
# 吉客云应用 AppKey。
JACKYUN_APP_KEY=
# 吉客云应用密钥。
JACKYUN_APP_SECRET=
# 吉客云商家授权 token，ISV 应用填写，自研应用可留空。
JACKYUN_TOKEN=
# 本地账套标识，已有数据后不要随意修改。
JACKYUN_SOURCE_KEY=jackyun
# 导入分页请求间隔，单位秒，允许 2～600。
JACKYUN_IMPORT_INTERVAL_SECONDS=5
# 单个导入任务的最大读取页数，达到后暂停。
JACKYUN_IMPORT_MAX_PAGES=2000

# HTTPS 访问设为 true，HTTP 调试设为 false。
SESSION_COOKIE_SECURE=false

# MySQL 数据库
# 数据库连接地址，按实际主机、端口和库名修改；%20 表示空格。
DB_URL=jdbc:mysql://127.0.0.1:3306/differentiated%20policy?connectionTimeZone=Asia/Shanghai&characterEncoding=UTF-8
# 数据库用户名。
DB_USERNAME=
# 数据库密码。
DB_PASSWORD=
