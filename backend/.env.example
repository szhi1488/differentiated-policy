# 后端唯一配置样例，本文件不会被应用读取，不在这里填写真实凭证。
# 新环境复制为同目录的 .env.local.properties，再填写真实值；已有实际配置不要覆盖。
# 同名系统环境变量优先于本地配置；修改后重启后端。

# 服务监听
# 本机开发仅监听 127.0.0.1；需要局域网访问时按部署要求填写监听地址。
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# 飞书登录
# 当前环境的飞书应用 ID，与下方密钥配套使用。
FEISHU_APP_ID=
# 飞书应用密钥。
FEISHU_APP_SECRET=
# 当前环境的飞书企业标识，必填；测试环境填测试企业，正式环境填正式公司。
FEISHU_TENANT_KEY=
# 必填：允许的前端 Origin，多个用英文逗号分隔，不带路径和末尾 /。
# 本机开发示例：http://localhost:5173,http://127.0.0.1:5173；正式环境填写实际站点。
FEISHU_ALLOWED_ORIGINS=

# 飞书政策通知
# 业务群的 chat_id，可留空。
FEISHU_POLICY_CHAT_ID=
# 回调方式：http 使用加密请求地址，long_connection 从 ERP 主动连接飞书，适合只有内网地址的电脑。
FEISHU_POLICY_CALLBACK_MODE=http
# HTTP 回调方式使用飞书开发者后台的 Encrypt Key、Verification Token。
FEISHU_CALLBACK_ENCRYPT_KEY=
FEISHU_CALLBACK_VERIFICATION_TOKEN=
# 开启后才会对外发送。每次轮询间隔以毫秒为单位。
POLICY_REVIEW_DELIVERY_ENABLED=false
POLICY_REVIEW_DELIVERY_POLL_MS=3000

# 吉客云商品查询与导入
# 吉客云应用 AppKey。
JACKYUN_APP_KEY=
# 吉客云应用密钥。
JACKYUN_APP_SECRET=
# 吉客云商家授权 token，ISV 应用填写，自研应用可留空。
JACKYUN_TOKEN=
# 本地商品账套标识，已有数据后保持稳定；与飞书企业标识无关。
JACKYUN_SOURCE_KEY=jackyun
# 导入分页请求间隔，单位秒，允许 2～600。
JACKYUN_IMPORT_INTERVAL_SECONDS=5
# 单个导入任务的最大读取页数，达到后暂停。
JACKYUN_IMPORT_MAX_PAGES=2000
# 商品导入、清洗的后台执行开关；false 会停止自动领取和处理任务。
JACKYUN_IMPORT_SCHEDULING_ENABLED=true
JACKYUN_CLEAN_SCHEDULING_ENABLED=true
# 后台检查任务的间隔，单位毫秒，允许 1000～60000；不同于上面的导入请求间隔。
JACKYUN_IMPORT_POLL_INTERVAL_MS=2000
JACKYUN_CLEAN_POLL_INTERVAL_MS=2000

# 外部接口超时，单位秒，均允许 1～60。
HTTP_CONNECT_TIMEOUT_SECONDS=5
FEISHU_REQUEST_TIMEOUT_SECONDS=10
JACKYUN_REQUEST_TIMEOUT_SECONDS=20

# HTTPS 访问设为 true，HTTP 调试设为 false。
SESSION_COOKIE_SECURE=false

# MySQL 数据库
# 必填：数据库连接地址，按实际主机、端口和库名填写；%20 表示空格。
# 格式：jdbc:mysql://主机:端口/库名?connectionTimeZone=Asia/Shanghai&characterEncoding=UTF-8
DB_URL=
# 数据库用户名。
DB_USERNAME=
# 数据库密码。
DB_PASSWORD=

# 附件存储根目录，不含 attachments；部署时填写稳定的绝对路径。
# Windows 使用正斜杠；本机留空时沿用项目 data 目录。
POLICY_STORAGE_ROOT=
